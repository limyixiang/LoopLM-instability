# Copy to cluster.env on the cluster and check the storage/interpreter paths.
# Defaults match gpu-long with one h100-96 GPU, 12 hours, 8 CPUs, and 96G host RAM.
# Loaded by the download, training, and submission wrappers on every invocation.
# Environment/inline overrides take precedence over these saved defaults.
export REPO_DIR="${REPO_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
# Leave the account empty to use your site's default; set it only if needed.
export PILOT_ACCOUNT="${PILOT_ACCOUNT:-}"
export PILOT_PARTITION="${PILOT_PARTITION:-gpu-long}"
export PILOT_STORAGE="${PILOT_STORAGE:-${SCRATCH:-$REPO_DIR}/ouro-pilot}"

export PYTHON_BIN="${PYTHON_BIN:-$REPO_DIR/.venv/bin/python}"
export HF_HOME="${HF_HOME:-$PILOT_STORAGE/hf_cache}"
export REPRO_DATA_DIR="${REPRO_DATA_DIR:-$PILOT_STORAGE/data/fineweb_edu}"
export TRAIN_DATA_DIR="${TRAIN_DATA_DIR:-$REPRO_DATA_DIR/train}"
export VAL_DATA_DIR="${VAL_DATA_DIR:-$REPRO_DATA_DIR/validation}"
export OUTPUT_ROOT="${OUTPUT_ROOT:-$PILOT_STORAGE/runs/reproduction}"

# If required by your site, add its module-load commands here so they also run
# in the batch job. For Conda/site Python, set PYTHON_BIN to its absolute path.
